# Imagem e interface
COMFYUI_IMAGE=longcat-avatar-comfyui:1.5
COMFYUI_BIND=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_ARGS=--preview-method auto
SHM_SIZE=16gb

# Modelos: official_int8_sharded, official_sharded ou single_file_safetensors
MODEL_MODE=official_int8_sharded

# Text encoder: clip_fp8 (menor) ou native (oficial, bem maior)
TEXT_ENCODER_MODE=clip_fp8
INCLUDE_VOCAL_SEPARATOR=1

# Preencha apenas se o Hugging Face exigir autenticação.
HF_TOKEN=

# Componentes da imagem
INSTALL_MANAGER=1
INSTALL_XFORMERS=0
INSTALL_FLASH_ATTN=0
