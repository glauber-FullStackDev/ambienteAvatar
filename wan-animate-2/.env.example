WAN_ANIMATE_2_IMAGE=wan-animate-2:latest
WAN_ANIMATE_2_BIND=127.0.0.1
WAN_ANIMATE_2_PORT=8188
SHM_SIZE=32gb

# base prioriza qualidade (40 passos); distilled prioriza velocidade (10 passos).
MODEL_VARIANT=base
DOWNLOAD_MODELS_ON_START=0

HF_TOKEN=
PYTORCH_DEVEL_IMAGE=pytorch/pytorch:2.7.1-cuda12.6-cudnn9-devel
PYTORCH_RUNTIME_IMAGE=pytorch/pytorch:2.7.1-cuda12.6-cudnn9-runtime
