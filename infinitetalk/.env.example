COMFYUI_IMAGE=infinitetalk-comfyui:latest
COMFYUI_BIND=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_ARGS=--preview-method auto
SHM_SIZE=16gb

# q4_k_m usa menos VRAM; q6_k e q8 priorizam qualidade.
MODEL_QUANTIZATION=q4_k_m
DOWNLOAD_MODELS_ON_START=0

HF_TOKEN=
PYTORCH_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
INSTALL_MANAGER=1
