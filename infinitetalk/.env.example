COMFYUI_IMAGE=infinitetalk-comfyui:latest
COMFYUI_BIND=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_ARGS=--preview-method auto
SHM_SIZE=16gb

# O workflow V2V padrao usa Q8. Use q4_k_m ou q6_k se precisar reduzir VRAM.
MODEL_QUANTIZATION=q8
DOWNLOAD_MODELS_ON_START=0
DOWNLOAD_LIPFORCING_MODELS_ON_START=0
LIPFORCING_ALLOW_LOW_VRAM=0

HF_TOKEN=
PYTORCH_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
INSTALL_MANAGER=1
