{
  "name": "ltx25-ia2v-bf16",
  "imageName": "ghcr.io/glauber-fullstackdev/ambienteavatar-ltx23-serverless:v2.5-bf16",
  "endpointType": "QUEUE",
  "workersMin": 0,
  "workersMax": 1,
  "idleTimeout": 30,
  "executionTimeout": 7200,
  "gpuTypes": [
    "NVIDIA RTX A6000",
    "NVIDIA A40"
  ],
  "env": {
    "MINIO_ENDPOINT": "https://minio.example.com",
    "MINIO_BUCKET": "ltx-serverless",
    "MINIO_REGION": "us-east-1",
    "MINIO_ACCESS_KEY": "CONFIGURE_AS_SECRET",
    "MINIO_SECRET_KEY": "CONFIGURE_AS_SECRET",
    "MINIO_OUTPUT_PREFIX": "ltx-ia2v/results",
    "MINIO_PRESIGN_EXPIRES_SECONDS": "86400",
    "MINIO_ALLOWED_HOST": "minio.example.com",
    "HF_TOKEN": "CONFIGURE_AS_SECRET"
  }
}
