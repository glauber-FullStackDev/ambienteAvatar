COMFYUI_IMAGE=wan-animate-comfyui:latest
COMFYUI_BIND=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_ARGS=--preview-method auto
SHM_SIZE=16gb

# e4m3fn e o padrao mais testado; e5m2 usa o checkpoint FP8 alternativo.
MODEL_VARIANT=e4m3fn
DOWNLOAD_MODELS_ON_START=0

HF_TOKEN=
PYTORCH_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
INSTALL_MANAGER=1
